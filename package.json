{
  "name": "muscle-keeper",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "build": "node scripts/check-voice.mjs && expo export --platform web && node scripts/prepare-web.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "build:cf": "PUBLIC_ORIGIN=https://p064-muscle-guardian.pages.dev npm run build",
    "deploy:cf": "npm run build:cf && node scripts/deploy-cf.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
